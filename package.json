{
  "name": "agent-context-bridge",
  "version": "0.1.0",
  "description": "Cross-agent context migration via a neutral Agent Work Bundle (Cursor ↔ Trae first)",
  "type": "module",
  "bin": {
    "acb": "./dist/index.js",
    "agent-context-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "web": "npm run build:web && tsx src/index.ts web",
    "web:dev": "tsx src/index.ts web --dev",
    "validate:sample": "tsx src/index.ts validate examples/sample.bundle.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "cursor",
    "trae",
    "mcp",
    "context-migration",
    "agents-md"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.1"
  }
}
